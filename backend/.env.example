# Environment Configuration for Snack Overflow Backend

# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 recommended)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/snack_overflow

# JWT Authentication
# In production, use a strong random secret key with at least 32 characters
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
ENVIRONMENT=development
# Comma-separated list of allowed origins. In production, add your Vercel URL
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-app.vercel.app
