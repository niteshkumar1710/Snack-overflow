# Environment Configuration for Snack Overflow Backend

# Supabase PostgreSQL Connection String
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
# Or direct connection: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/snack_overflow

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_key_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Settings
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
